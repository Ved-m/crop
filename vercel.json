{
  "version": 2,
  "builds": [
    {
      "src": "api/predict.py",
      "use": "@vercel/python"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "^/api/predict$", "dest": "api/predict.py" },
    { "src": "^/api/model-info$", "dest": "api/predict.py" },
    { "src": "^/api/health$", "dest": "api/predict.py" },
    { "src": "/", "dest": "/public/index.html" },
    { "src": "/(.*)", "dest": "/public/$1" }
  ]
}
