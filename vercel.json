{
  "version": 2,
  "builds": [
    {
      "src": "api/predict.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/api/predict",
      "dest": "api/predict.py"
    },
    {
      "src": "/api/health",
      "dest": "api/predict.py"
    },
    {
      "src": "/(.*)",
      "dest": "api/predict.py"
    }
  ]
}
